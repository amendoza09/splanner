{
  "name": "Splanner",
  "version": "1.2.3",
  "private": true,
  "main": "electron.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "cross-env TZ=America/New_York react-scripts test",
    "electron-dev": "concurrently \"BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-prod": "cross-env NODE_OPTIONS=--max-old-space-size=4096 react-scripts build && electron-builder ."
  },
  "build": {
    "appId": "com.toni.Splanner",
    "productName": "Splanner",
    "extraMetadata": {
      "main": "electron.js"
    },
    "files": [
      "build/**/*",
      "electron.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "axios": "^1.13.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.0",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.19",
    "wait-on": "^9.0.3"
  }
}
